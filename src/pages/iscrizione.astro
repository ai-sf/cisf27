---
import 'katex/dist/katex.min.css';
import PageLayout from '../layouts/PageLayout.astro';
import RegistrationForm from '../components/RegistrationForm.svelte';
import { getCmsData, getLocale } from '../data/cms';
import { getPageLink } from '../data/pageLinks.ts';
import { getPeople } from '../data/people.ts';
import { getStructureById } from '../data/structures.ts';
import { resolveAssetHref } from '../utils/helpers';

const locale = getLocale(Astro);
const { registration, criteria } = getCmsData(locale);
// RegistrationForm UI copy is Italian-only; load shared IT conference/pricing/structure data cleanly
const { conference: confIt, pricing: pricingIt } = getCmsData('it');

const criteriPdfUrl = resolveAssetHref(
	criteria.documents?.criteriaPdf?.downloadUrl ?? '/docs/Criteri_di_selezione_CISF27.pdf'
);
const codiceEticoPdfUrl = resolveAssetHref(
	criteria.documents?.ethicsPdf?.downloadUrl ?? '/docs/Codice_Etico_CISF27.pdf'
);
const criteriLink = getPageLink('criteri', 'it');
const criteriPageUrl = criteriLink.href;
const siteHost = Astro.site ? Astro.site.host : 'ai-sf.it';
const criteriPublicUrlLabel = `${siteHost}${criteriPageUrl}`;

const contactEmail =
	getPeople('it').find((p) => p.roleId === 'contatto-principale')?.email ?? 'cisf27@ai-sf.it';
const comboStructure = getStructureById('combo', 'it');

const conferenceTitle = confIt.title ?? 'CISF27';
const conferenceLocation = confIt.location ?? 'Bologna';
const conferenceDates = confIt.fullDates ?? '19–23 aprile 2027';
const priceWithAccommodation = pricingIt[0]?.price ?? '€120';
const priceWithoutAccommodation = pricingIt[1]?.price ?? '€70';
const accommodationName = comboStructure?.label ?? 'Combo Bologna';
---

<PageLayout title={registration.pageTitle} description={registration.pageDescription}>
	<div
		class="bg-base-200/50 from-primary/5 to-warning/5 min-h-screen w-full overflow-x-hidden bg-linear-to-br via-transparent pb-28 sm:pb-20"
	>
		<RegistrationForm
			client:load
			{criteriPdfUrl}
			{codiceEticoPdfUrl}
			{criteriPageUrl}
			{criteriPublicUrlLabel}
			{conferenceTitle}
			{conferenceLocation}
			{conferenceDates}
			{contactEmail}
			{priceWithAccommodation}
			{priceWithoutAccommodation}
			{accommodationName}
		/>
	</div>
</PageLayout>

<script>
	let hydrationWatchdogId: number | null = null;

	const startHydrationWatchdog = () => {
		if (hydrationWatchdogId !== null) {
			window.clearTimeout(hydrationWatchdogId);
			hydrationWatchdogId = null;
		}
		const root = document.querySelector<HTMLElement>('.cisf-registration-root');
		if (!root) return;

		hydrationWatchdogId = window.setTimeout(() => {
			const currentRoot = document.querySelector<HTMLElement>('.cisf-registration-root');
			const fallback = document.getElementById('cisf-hydration-fallback');
			if (currentRoot && currentRoot.dataset.cisfHydrated !== 'true' && fallback) {
				fallback.classList.remove('hidden');
				const reloadBtn = document.getElementById('cisf-hydration-reload-btn');
				reloadBtn?.addEventListener('click', () => window.location.reload(), { once: true });
			}
		}, 8000);
	};

	document.addEventListener('astro:page-load', startHydrationWatchdog);
	document.addEventListener('astro:before-swap', () => {
		if (hydrationWatchdogId !== null) {
			window.clearTimeout(hydrationWatchdogId);
			hydrationWatchdogId = null;
		}
	});
</script>
