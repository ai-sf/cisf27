---
import 'katex/dist/katex.min.css';
import PageLayout from '../layouts/PageLayout.astro';
import RegistrationForm from '../components/RegistrationForm.svelte';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const criteriPdfUrl = `${base}/docs/Criteri_di_selezione_CISF27.pdf`;
const codiceEticoPdfUrl = `${base}/docs/Codice_Etico_CISF27.pdf`;
const criteriPageUrl = `${base}/criteri`;
---

<PageLayout
	title="Candidatura"
	description="Modulo ufficiale di candidatura per la Conferenza Italiana degli Studenti di Fisica — CISF27 Bologna (19–23 aprile 2027)."
>
	<div
		class="min-h-screen w-full overflow-x-hidden bg-[#faf7f2] pb-28 sm:pb-20"
		style="color-scheme: light; background-image: radial-gradient(at 0% 0%, rgba(158, 42, 43, 0.05) 0px, transparent 50%), radial-gradient(at 100% 100%, rgba(224, 159, 62, 0.06) 0px, transparent 50%);"
	>
		<RegistrationForm client:load {criteriPdfUrl} {codiceEticoPdfUrl} {criteriPageUrl} />
	</div>
</PageLayout>

<script>
	let hydrationWatchdogId: number | null = null;

	const startHydrationWatchdog = () => {
		if (hydrationWatchdogId !== null) {
			window.clearTimeout(hydrationWatchdogId);
			hydrationWatchdogId = null;
		}
		const root = document.querySelector<HTMLElement>('.cisf-registration-root');
		if (!root) return;

		hydrationWatchdogId = window.setTimeout(() => {
			const currentRoot = document.querySelector<HTMLElement>('.cisf-registration-root');
			const fallback = document.getElementById('cisf-hydration-fallback');
			if (currentRoot && currentRoot.dataset.cisfHydrated !== 'true' && fallback) {
				fallback.classList.remove('hidden');
				const reloadBtn = document.getElementById('cisf-hydration-reload-btn');
				reloadBtn?.addEventListener('click', () => window.location.reload(), { once: true });
			}
		}, 8000);
	};

	document.addEventListener('astro:page-load', startHydrationWatchdog);
	document.addEventListener('astro:before-swap', () => {
		if (hydrationWatchdogId !== null) {
			window.clearTimeout(hydrationWatchdogId);
			hydrationWatchdogId = null;
		}
	});
</script>
