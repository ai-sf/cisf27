---
import { Image } from 'astro:assets';
import {
	Scale,
	Download,
	FileText,
	ArrowRight,
	Users,
	BedDouble,
	Award,
	MapPin,
	TrendingUp,
	Sparkles,
	GraduationCap,
	HeartHandshake,
	TriangleAlert,
	Clock,
	Info,
	ShieldCheck,
	ShieldAlert,
	Ban,
	Leaf,
	Eye,
	Lock,
	Mail,
	CircleCheck,
	ExternalLink,
	NotebookPen,
	ClipboardCheck,
	Globe,
} from '@lucide/astro';
import PageLayout from '../layouts/PageLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import SectionBadge from '../components/SectionBadge.astro';
import GradientSpan from '../components/GradientSpan.astro';
import CTASection from '../components/CTASection.astro';
import { getLocale } from '../data/cms';
import { getPageLink } from '../data/pageLinks.ts';
import plasticFreerLogo from '../assets/images/partners/plasticfreeemiliaromagna.png';

const locale = getLocale(Astro);
const isEn = locale === 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const criteriPdfUrl = `${base}/docs/Criteri_di_selezione_CISF27.pdf`;
const codiceEticoPdfUrl = `${base}/docs/Codice_Etico_CISF27.pdf`;
const iscrizioneUrl = `${base}/iscrizione`;
const aboutLink = getPageLink('about', locale);
const contactLink = getPageLink('contact', locale);

const quickStats = isEn
	? [
			{
				value: '170',
				label: 'Open call spots',
				detail: '150 Combo Bologna + 20 independent',
			},
			{
				value: '5 / 8',
				label: 'Minimum LC quotas',
				detail: '5 per LC · 8 for AISF Calabria',
			},
			{
				value: '7 days',
				label: 'Payment deadline',
				detail: 'With a single official waiting-list round',
			},
			{
				value: '100%',
				label: 'Ethics & Non-Profit',
				detail: 'Safe Space · #Plastic-freER · No weapons',
			},
		]
	: [
			{
				value: '170',
				label: 'Partecipanti a bando',
				detail: '150 Combo Bologna + 20 autonomi',
			},
			{
				value: '5 / 8',
				label: 'Quote minime LC',
				detail: '5 per ogni LC · 8 per AISF Calabria',
			},
			{
				value: '7 gg',
				label: 'Termine pagamento',
				detail: 'Con un solo ripescaggio ufficiale',
			},
			{
				value: '100%',
				label: 'Etica & No-Profit',
				detail: 'Safe Space · #Plastic-freER · No armi',
			},
		];

const rejectionCauses = isEn
	? [
			{
				title: 'Evident use of Artificial Intelligence',
				desc: 'The motivation is produced with clear and evident passive use of AI, lacking genuine personal contribution.',
			},
			{
				title: 'False or misleading statements',
				desc: 'Any falsehood regarding personal details, associative roles, Local Committee activities, or previous participations.',
			},
			{
				title: 'Hate speech, threats, or propaganda',
				desc: 'Insults, threats, hate speech of any kind, propaganda messages, slurs, and any statement contrary to the AISF Statute and the OC Code of Ethics.',
			},
			{
				title: 'Failure to register with AISF on time',
				desc: 'The selected applicant is not duly registered as an AISF member by no later than the CISF27 registration fee payment deadline.',
			},
		]
	: [
			{
				title: 'Utilizzo evidente di Intelligenza Artificiale',
				desc: 'La motivazione è creata con chiaro ed evidente utilizzo passivo di IA, privo di autentico apporto personale.',
			},
			{
				title: 'Dichiarazioni false o mendaci',
				desc: 'Qualunque falsità su dati anagrafici, ruoli associativi, attività nel Comitato Locale o partecipazioni pregresse.',
			},
			{
				title: "Contenuti d'odio, minacce o propaganda",
				desc: 'Insulti, minacce, messaggi di odio di ogni tipo, messaggi di propaganda, ingiurie e ogni affermazione in contrasto con lo Statuto AISF e il Codice Etico del CO.',
			},
			{
				title: 'Mancata iscrizione ad AISF nei termini',
				desc: 'La persona selezionata non risulti regolarmente iscritta ad AISF al massimo entro i termini previsti per il pagamento della quota CISF27.',
			},
		];

const evaluationFactors = isEn
	? [
			'Number of participations in previous CISF editions and other AISF events;',
			"Active involvement in one's Local Committee (LC), in the Board of Presidents, and in organising local and national events;",
			'Willingness to give a parallel session (talk) during the Conference;',
			'Curiosity towards the various scientific, cultural, and associative aspects of the Conference;',
			"Genuine enthusiasm expressed in one's creative motivation.",
		]
	: [
			'Numero di partecipazioni a CISF precedenti e ad altri eventi AISF;',
			'Partecipazione attiva nel proprio Comitato Locale (LC), nel Consiglio di Presidenza e nell’organizzazione di eventi locali e nazionali;',
			'Disponibilità a tenere una parallel session (talk) durante la Conferenza;',
			'Curiosità verso i vari aspetti scientifici, culturali e associativi della Conferenza;',
			'Entusiasmo autentico emerso nella propria motivazione creativa.',
		];

const ethicsPillars = isEn
	? [
			{
				icon: HeartHandshake,
				title: 'Inclusivity, Equality & Accessibility',
				badge: 'CISF belongs to everyone',
				accentBg: 'from-primary/20 to-secondary/20',
				iconColor: 'text-primary',
				borderColor: 'border-primary/30',
				badgeClass: 'badge-primary badge-soft',
				description:
					'CISF27 operates without discrimination of any kind (Art. 14 AISF Statute) to break down social, economic, academic, and physical barriers. Active commitment to gender equality, protection of every identity, respectful language, guaranteed accessibility, and a non-profit spirit with subsidised fees.',
				points: [
					'Gender equality and full respect for chosen identities and pronouns',
					'Allergies, disabilities, and logistical needs protected and neutral in selection',
					'100% non-profit conference with subsidised fees thanks to our partners',
				],
			},
			{
				icon: ShieldAlert,
				title: 'Safe Space & Zero Tolerance',
				badge: 'AISF Statute · IAPS',
				accentBg: 'from-error/20 to-primary/20',
				iconColor: 'text-error',
				borderColor: 'border-error/30',
				badgeClass: 'badge-error badge-soft',
				description:
					'Everyone has the right to a safe, welcoming, and hostility-free environment both in scientific sessions and social moments. In line with the IAPS Code of Conduct, zero tolerance applies to discrimination, verbal, physical, or sexual harassment, intimidation, and hate speech.',
				points: [
					'Consent is always free, active, informed, explicit, and revocable',
					'Immediate rejection of applications containing hate speech or threats',
					'Timely precautionary measures and coordination with Art. 17 AISF Statute',
				],
			},
			{
				icon: Ban,
				title: 'No Sponsors from the Arms & Defence Industry',
				badge: 'Unanimous OC Resolution',
				accentBg: 'from-warning/20 to-primary/20',
				iconColor: 'text-warning',
				borderColor: 'border-warning/40',
				badgeClass: 'badge-warning badge-soft',
				description:
					'The Organising Committee has unanimously resolved to categorically refuse funding, sponsorships (financial or technical), and direct (“first-degree”) collaborations with companies in the arms industry, weapons production, or directly implicated in armed conflicts.',
				points: [
					'Strict exclusion of partners directly tied to warfare and weapons',
					'Collegial and transparent evaluation of indirect relationships',
					'Full scientific, cultural, and associative independence from sponsors',
				],
			},
			{
				icon: Leaf,
				title: 'Environmental Sustainability #Plastic-freER',
				badge: 'Emilia-Romagna Region',
				accentBg: 'from-success/20 to-info/20',
				iconColor: 'text-success',
				borderColor: 'border-success/35',
				badgeClass: 'badge-success badge-soft',
				description:
					'With the official patronage of the Emilia-Romagna Region, CISF27 joins the regional #Plastic-freER strategy to eliminate single-use plastics and promote responsible practices throughout the entire conference week.',
				points: [
					'No single-use plastics at coffee breaks, lunches, dinners, and events',
					'Reusable water bottles, sustainable tableware, and waste reduction',
					'Sustainable urban mobility in Bologna with TPER public transport passes for participants',
				],
				hasPlasticFreeLogo: true,
			},
			{
				icon: Scale,
				title: 'Non-Partisanship & Institutional Neutrality',
				badge: 'AISF Strategic Plan',
				accentBg: 'from-info/20 to-primary/20',
				iconColor: 'text-info',
				borderColor: 'border-info/30',
				badgeClass: 'badge-info badge-soft',
				description:
					'AISF and CISF27 are strictly non-partisan and non-denominational, independent from political parties, movements, and lobby groups, to safeguard freedom of participation, scientific pluralism, and the unity of the student community.',
				points: [
					'Refusal of direct political funding and affiliations',
					'Ban on partisan propaganda in applications and conference venues',
					'Free and democratic scientific dialogue on science and society',
				],
			},
			{
				icon: Eye,
				title: 'Transparency, Integrity & Guarantees',
				badge: 'AISF EC Oversight',
				accentBg: 'from-secondary/20 to-accent/20',
				iconColor: 'text-secondary',
				borderColor: 'border-secondary/30',
				badgeClass: 'badge-secondary badge-soft',
				description:
					'Every selection rule, ethical principle, and organisational decision is made public and verifiable. The national AISF Executive Committee (EC) oversees the entire process to guarantee fairness, equity, and intellectual integrity.',
				points: [
					'Selection Criteria and Code of Ethics freely accessible',
					'Right to request clarifications from the OC and the EC',
					'Transparent non-profit management and protection against any retaliation',
				],
			},
		]
	: [
			{
				icon: HeartHandshake,
				title: 'Inclusività, Parità & Accessibilità',
				badge: 'La CISF è di tutti',
				accentBg: 'from-primary/20 to-secondary/20',
				iconColor: 'text-primary',
				borderColor: 'border-primary/30',
				badgeClass: 'badge-primary badge-soft',
				description:
					'CISF27 opera senza alcuna discriminazione (Art. 14 Statuto AISF) per abbattere barriere sociali, economiche, accademiche e fisiche. Impegno attivo per la parità di genere, tutela di ogni identità, linguaggio rispettoso, accessibilità garantita e spirito no-profit con quote calmierate.',
				points: [
					'Parità di genere e pieno rispetto di identità e pronomi scelti',
					'Allergie, disabilità e necessità logistiche tutelate e neutre in selezione',
					'Conferenza 100% no-profit con quote agevolate grazie ai partner',
				],
			},
			{
				icon: ShieldAlert,
				title: 'Safe Space & Tolleranza Zero',
				badge: 'Statuto AISF · IAPS',
				accentBg: 'from-error/20 to-primary/20',
				iconColor: 'text-error',
				borderColor: 'border-error/30',
				badgeClass: 'badge-error badge-soft',
				description:
					'Ogni persona ha diritto a un ambiente sicuro, accogliente e privo di ostilità sia nelle sessioni scientifiche sia nei momenti sociali. In linea con il Code of Conduct IAPS, vige tolleranza zero verso discriminazioni, molestie verbali, fisiche o sessuali, intimidazioni e messaggi d’odio.',
				points: [
					'Consenso sempre libero, attivo, informato, esplicito e revocabile',
					'Rigetto immediato di candidature con contenuti d’odio o minacce',
					'Misure cautelari tempestive e raccordo con Art. 17 Statuto AISF',
				],
			},
			{
				icon: Ban,
				title: 'No Sponsor da Industria Bellica & Armi',
				badge: 'Delibera Unanime CO',
				accentBg: 'from-warning/20 to-primary/20',
				iconColor: 'text-warning',
				borderColor: 'border-warning/40',
				badgeClass: 'badge-warning badge-soft',
				description:
					'Il Comitato Organizzatore ha deliberato all’unanimità il rifiuto categorico di finanziamenti, sponsorizzazioni (economiche o tecniche) e collaborazioni dirette («di primo grado») con aziende dell’industria bellica, della produzione di armi o direttamente implicate in conflitti armati.',
				points: [
					'Esclusione inderogabile di partner direttamente legati a guerra e armi',
					'Valutazione collegiale e trasparente sulle relazioni indirette',
					'Piena indipendenza scientifica, culturale e associativa dagli sponsor',
				],
			},
			{
				icon: Leaf,
				title: 'Sostenibilità Ambientale #Plastic-freER',
				badge: 'Regione Emilia-Romagna',
				accentBg: 'from-success/20 to-info/20',
				iconColor: 'text-success',
				borderColor: 'border-success/35',
				badgeClass: 'badge-success badge-soft',
				description:
					'Con il patrocinio ufficiale della Regione Emilia-Romagna, CISF27 aderisce alla strategia regionale #Plastic-freER per azzerare la plastica monouso e promuovere comportamenti responsabili lungo tutta la settimana della conferenza.',
				points: [
					'Stop plastica monouso in coffee break, pranzi, cene ed eventi',
					'Borracce riutilizzabili, stoviglie sostenibili e lotta agli sprechi',
					'Mobilità urbana sostenibile a Bologna con titoli TPER per i partecipanti',
				],
				hasPlasticFreeLogo: true,
			},
			{
				icon: Scale,
				title: 'Apartiticità & Neutralità Istituzionale',
				badge: 'Piano Strategico AISF',
				accentBg: 'from-info/20 to-primary/20',
				iconColor: 'text-info',
				borderColor: 'border-info/30',
				badgeClass: 'badge-info badge-soft',
				description:
					'AISF e CISF27 sono rigorosamente apartitiche e aconfessionali, indipendenti da partiti, movimenti politici e gruppi di pressione, per tutelare la libertà di partecipazione, il pluralismo scientifico e l’unità della comunità studentesca.',
				points: [
					'Rifiuto di finanziamenti e affiliazioni politiche dirette',
					'Divieto di propaganda partitica nelle candidature e negli spazi',
					'Confronto scientifico libero e democratico su scienza e società',
				],
			},
			{
				icon: Eye,
				title: 'Trasparenza, Integrità & Garanzie',
				badge: 'Supervisione EC AISF',
				accentBg: 'from-secondary/20 to-accent/20',
				iconColor: 'text-secondary',
				borderColor: 'border-secondary/30',
				badgeClass: 'badge-secondary badge-soft',
				description:
					'Ogni regola di selezione, principio etico e scelta organizzativa è resa pubblica e verificabile. Il Comitato Esecutivo (EC) nazionale di AISF supervisiona l’intero percorso a garanzia di correttezza, equità e integrità intellettuale.',
				points: [
					'Criteri e Codice Etico accessibili liberamente',
					"Diritto di chiedere chiarimenti al CO e all'EC",
					'Gestione trasparente no-profit e tutele contro qualsiasi ritorsione',
				],
			},
		];

const confidentialContacts = isEn
	? [
			{
				name: 'Francesco Isgrò',
				role: 'Sponsors & PR, social events, catering & meals, laboratory visits',
				email: 'francesco.isgro@ai-sf.it',
				initials: 'FI',
			},
			{
				name: "Alessandro D'Agostino",
				role: 'Venues, programme, treasury, accommodation & transport',
				email: 'alessandro.dagostino@ai-sf.it',
				initials: 'AD',
			},
		]
	: [
			{
				name: 'Francesco Isgrò',
				role: 'Sponsor e PR, eventi sociali, catering e pasti, laboratori',
				email: 'francesco.isgro@ai-sf.it',
				initials: 'FI',
			},
			{
				name: "Alessandro D'Agostino",
				role: 'Spazi, programma, tesoreria, alloggi e trasporti',
				email: 'alessandro.dagostino@ai-sf.it',
				initials: 'AD',
			},
		];
---

<PageLayout
	title={isEn ? 'Selection Criteria & Code of Ethics' : 'Criteri di Selezione & Codice Etico'}
	description={isEn
		? 'Official selection criteria, participation guidelines, and Code of Ethics adopted by the CISF27 Bologna Organising Committee (19–23 April 2027).'
		: 'Criteri di selezione ufficiali, modalità di partecipazione e Codice Etico adottato dal Comitato Organizzatore di CISF27 Bologna (19–23 aprile 2027).'}
>
	<!-- =================================================================== -->
	<!-- HERO SECTION                                                        -->
	<!-- =================================================================== -->
	<HeroSection
		icon={Scale}
		label={isEn
			? 'Transparency & Values · CISF27 Bologna'
			: 'Trasparenza & Valori · CISF27 Bologna'}
		badgeClass="badge-primary"
		heading={isEn ? 'Selection Criteria & Code of Ethics' : 'Criteri di Selezione e Codice Etico'}
		headingClass="from-primary to-secondary"
		bgClass="from-primary/5 to-secondary/5"
		subtitle={isEn
			? 'All official documents approved by the CISF27 Organising Committee (OC) and overseen by the AISF Executive Committee (EC), freely accessible and downloadable even outside the application form.'
			: 'Tutti i documenti ufficiali approvati dal Comitato Organizzatore CISF27 e supervisionati dal Comitato Esecutivo AISF, liberamente consultabili e scaricabili anche al di fuori del modulo di candidatura.'}
	>
		<!-- Primary & Secondary Hero CTAs -->
		<div class="flex flex-col items-center justify-center gap-3 sm:flex-row sm:flex-wrap sm:gap-4">
			<a
				href={criteriPdfUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-primary btn-lg shadow-primary/25 hover:shadow-primary/40 card-interactive glow-hover h-auto min-h-13 gap-2.5 px-6 py-3 text-base shadow-xl"
			>
				<Download class="size-5 shrink-0" />
				<span>
					{
						isEn
							? 'Download Official Selection Criteria PDF (IT)'
							: 'Scarica il PDF Ufficiale dei Criteri di Selezione'
					}
				</span>
			</a>
			<a
				href={iscrizioneUrl}
				class="btn btn-secondary btn-outline btn-lg card-interactive h-auto min-h-13 gap-2 px-6 py-3 text-base"
			>
				<NotebookPen class="size-5 shrink-0" />
				<span>{isEn ? 'Go to Application Form (IT)' : 'Vai al Modulo di Candidatura'}</span>
				<ArrowRight class="size-4 shrink-0" />
			</a>
		</div>

		<!-- Direct Ethical Code PDF Download + Quick Jump Links -->
		<div class="mt-5 flex flex-wrap items-center justify-center gap-2.5 text-sm">
			<a
				href={codiceEticoPdfUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-sm btn-ghost border-secondary/30 bg-base-100/80 text-secondary hover:bg-secondary/10 gap-2 border"
			>
				<FileText class="size-4 shrink-0" />
				<span>
					{
						isEn
							? 'Download Official Code of Ethics PDF (IT)'
							: 'Scarica il PDF Codice Etico Ufficiale'
					}
				</span>
				<ExternalLink class="size-3.5 shrink-0 opacity-70" />
			</a>
			<span class="text-base-content/30 hidden sm:inline">·</span>
			<a href="#criteri-selezione" class="link link-hover text-base-content/70 font-medium">
				{isEn ? 'Jump to Criteria' : 'Vai ai Criteri'}
			</a>
			<span class="text-base-content/30">·</span>
			<a href="#codice-etico" class="link link-hover text-base-content/70 font-medium">
				{isEn ? 'Jump to Code of Ethics' : 'Vai al Codice Etico'}
			</a>
			<span class="text-base-content/30">·</span>
			<a href="#contatti-riservati" class="link link-hover text-base-content/70 font-medium">
				{isEn ? 'Confidential Contacts' : 'Contatti Riservati'}
			</a>
		</div>

		{
			isEn && (
				<div class="border-info/30 bg-info/8 text-base-content/80 mx-auto mt-6 flex max-w-3xl items-start gap-3 rounded-xl border px-4 py-3 text-left text-xs leading-relaxed sm:text-sm">
					<Globe class="text-info mt-0.5 size-4 shrink-0 sm:size-5" />
					<p>
						<strong>Language notice:</strong> All links to the official PDFs (Selection Criteria
						&amp; Code of Ethics) and the application form point to their{' '}
						<strong>Italian-language versions</strong>. Because CISF27 is conducted entirely in
						Italian without translations, a sufficient (at least passive) knowledge of Italian is
						required to participate.
					</p>
				</div>
			)
		}

		<!-- Quick Key Numbers Strip -->
		<div
			class="bg-base-200/70 border-base-300/60 rounded-box mx-auto mt-10 grid max-w-4xl grid-cols-2 gap-px border shadow-sm backdrop-blur-sm sm:grid-cols-4"
		>
			{
				quickStats.map((stat) => (
					<div class="stat bg-base-100/70 px-4 py-5 text-center">
						<div class="stat-value from-primary to-secondary bg-linear-to-r bg-clip-text text-2xl text-transparent sm:text-3xl">
							{stat.value}
						</div>
						<div class="stat-title text-base-content/85 mt-1 text-xs font-bold sm:text-sm">
							{stat.label}
						</div>
						<div class="stat-desc text-base-content/60 mt-0.5 text-[11px] whitespace-normal">
							{stat.detail}
						</div>
					</div>
				))
			}
		</div>
	</HeroSection>

	<!-- =================================================================== -->
	<!-- SEZIONE 1: SINTESI VISIVA DEI CRITERI PUBBLICI DI SELEZIONE         -->
	<!-- =================================================================== -->
	<section id="criteri-selezione" class="reveal bg-base-200/50 py-20 lg:py-24">
		<div class="container mx-auto px-4 lg:px-8">
			<div class="mx-auto mb-14 max-w-3xl text-center">
				<SectionBadge
					icon={ClipboardCheck}
					label={isEn ? 'Section 1 · Public Criteria' : 'Sezione 1 · Criteri Pubblici'}
					badgeClass="badge-primary"
				/>
				<h2 class="mb-4 text-3xl font-bold sm:text-4xl md:text-5xl">
					{
						isEn ? (
							<>
								Summary of the <GradientSpan>Selection Criteria</GradientSpan>
							</>
						) : (
							<>
								Sintesi dei <GradientSpan>Criteri di Selezione</GradientSpan>
							</>
						)
					}
				</h2>
				<p class="text-base-content/70 text-base leading-relaxed sm:text-lg">
					{
						isEn ? (
							<>
								CISF27 will take place in <strong>Bologna from 19 to 23 April 2027</strong>. Below
								are the official criteria that the Organising Committee will apply should
								applications exceed the available spots.
							</>
						) : (
							<>
								CISF27 si terrà a <strong>Bologna dal 19 al 23 aprile 2027</strong>. Di seguito i
								criteri ufficiali che il Comitato Organizzatore applicherà laddove le candidature
								superino i posti disponibili.
							</>
						)
					}
				</p>
			</div>

			<div class="mx-auto max-w-6xl space-y-6">
				<!-- Row 1: Posti & Alloggio (Featured) + Ammessi di Diritto -->
				<div class="reveal-stagger grid gap-6 lg:grid-cols-12">
					<!-- Card: 170 Partecipanti & Alloggio Combo Bologna -->
					<div
						class="card card-border border-primary/30 bg-base-100 card-interactive lg:col-span-7"
					>
						<div class="card-body p-6 sm:p-8">
							<div class="mb-4 flex flex-wrap items-center justify-between gap-2">
								<div class="flex items-center gap-3">
									<div
										class="from-primary/20 to-accent/20 flex size-12 shrink-0 items-center justify-center rounded-xl bg-linear-to-br"
									>
										<BedDouble class="text-primary size-6" />
									</div>
									<div>
										<h3 class="card-title text-xl sm:text-2xl">
											{
