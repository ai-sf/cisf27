---
import { Image } from 'astro:assets';
import {
	Scale,
	Download,
	FileText,
	ArrowRight,
	Users,
	BedDouble,
	Award,
	MapPin,
	TrendingUp,
	Sparkles,
	GraduationCap,
	TriangleAlert,
	Clock,
	Info,
	ShieldCheck,
	Lock,
	Mail,
	CircleCheck,
	ExternalLink,
	NotebookPen,
	ClipboardCheck,
	Globe,
} from '@lucide/astro';
import PageLayout from '../layouts/PageLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import SectionBadge from '../components/SectionBadge.astro';
import GradientSpan from '../components/GradientSpan.astro';
import CTASection from '../components/CTASection.astro';
import { criteriaData as baseCriteria, getCmsData, getLocale } from '../data/cms';
import { getPageLink, resolveHref } from '../data/pageLinks.ts';
import { getPeople } from '../data/people.ts';
import { resolveAssetHref, resolveIcon } from '../utils/helpers';
import plasticFreerLogo from '../assets/images/partners/plasticfreeemiliaromagna.png';

const locale = getLocale(Astro);
const { criteria } = getCmsData(locale);

const docs = criteria.documents;
const baseDocs = baseCriteria.documents;
const criteriPdfUrl = resolveAssetHref(
	baseDocs?.criteriaPdf?.downloadUrl ??
		docs?.criteriaPdf?.downloadUrl ??
		'/docs/Criteri_di_selezione_CISF27.pdf'
);
const codiceEticoPdfUrl = resolveAssetHref(
	baseDocs?.ethicsPdf?.downloadUrl ??
		docs?.ethicsPdf?.downloadUrl ??
		'/docs/Codice_Etico_CISF27.pdf'
);
const iscrizioneUrl = resolveHref('/iscrizione');
const aboutLink = getPageLink('about', locale);
const contactLink = getPageLink('contact', locale);

const allPeople = getPeople(locale);
const mainEmail =
	allPeople.find((p) => p.roleId === 'contatto-principale')?.email ?? 'cisf27@ai-sf.it';
const confidentialContacts = allPeople.filter(
	(p) => p.roleId === 'coordinatore-fra' || p.roleId === 'coordinatore-ale'
);

const getInitials = (name: string) =>
	name
		.split(/\s+/)
		.filter(Boolean)
		.slice(0, 2)
		.map((n) => n[0]?.toUpperCase() ?? '')
		.join('');

const hero = criteria.hero;
const quickStats = hero?.quickStats ?? [];
const selection = criteria.selectionSection;
const accommodation = selection?.accommodationCard;
const automaticallyAdmitted = selection?.automaticallyAdmitted;
const minQuotas = selection?.minQuotasCard;
const proportionality = selection?.proportionalityCard;
const parity = selection?.parityCard;
const academic = selection?.academicCard;
const factors = selection?.factorsCard;
const rejection = selection?.rejectionCard;
const payments = selection?.paymentsCard;
const guarantees = selection?.guaranteesCard;
const ethics = criteria.ethicsSection;
const confidentialBox = ethics?.confidentialBox;
const cta = criteria.cta;

const pillarStyleMap: Record<
	string,
	{ accentBg: string; iconColor: string; borderColor: string; badgeClass: string }
> = {
	primary: {
		accentBg: 'from-primary/20 to-secondary/20',
		iconColor: 'text-primary',
		borderColor: 'border-primary/30',
		badgeClass: 'badge-primary badge-soft',
	},
	error: {
		accentBg: 'from-error/20 to-primary/20',
		iconColor: 'text-error',
		borderColor: 'border-error/30',
		badgeClass: 'badge-error badge-soft',
	},
	warning: {
		accentBg: 'from-warning/20 to-primary/20',
		iconColor: 'text-warning',
		borderColor: 'border-warning/40',
		badgeClass: 'badge-warning badge-soft',
	},
	success: {
		accentBg: 'from-success/20 to-info/20',
		iconColor: 'text-success',
		borderColor: 'border-success/35',
		badgeClass: 'badge-success badge-soft',
	},
	info: {
		accentBg: 'from-info/20 to-primary/20',
		iconColor: 'text-info',
		borderColor: 'border-info/30',
		badgeClass: 'badge-info badge-soft',
	},
	secondary: {
		accentBg: 'from-secondary/20 to-accent/20',
		iconColor: 'text-secondary',
		borderColor: 'border-secondary/30',
		badgeClass: 'badge-secondary badge-soft',
	},
};
---

<PageLayout title={criteria.pageTitle} description={criteria.pageDescription}>
	<!-- =================================================================== -->
	<!-- HERO SECTION                                                        -->
	<!-- =================================================================== -->
	<HeroSection
		icon={Scale}
		label={hero?.label}
		badgeClass="badge-primary"
		heading={hero?.heading}
		headingClass="from-primary to-secondary"
		bgClass="from-primary/5 to-secondary/5"
		subtitle={hero?.subtitle}
	>
		<!-- Primary & Secondary Hero CTAs -->
		<div class="flex flex-col items-center justify-center gap-3 sm:flex-row sm:flex-wrap sm:gap-4">
			<a
				href={criteriPdfUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-primary btn-lg shadow-primary/25 hover:shadow-primary/40 card-interactive glow-hover h-auto min-h-13 gap-2.5 px-6 py-3 text-base shadow-xl"
			>
				<Download class="size-5 shrink-0" />
				<span>{docs?.criteriaPdf?.heroLabel}</span>
			</a>
			<a
				href={iscrizioneUrl}
				class="btn btn-secondary btn-outline btn-lg card-interactive h-auto min-h-13 gap-2 px-6 py-3 text-base"
			>
				<NotebookPen class="size-5 shrink-0" />
				<span>{hero?.applyBtn}</span>
				<ArrowRight class="size-4 shrink-0" />
			</a>
		</div>

		<!-- Direct Ethical Code PDF Download + Quick Jump Links -->
		<div class="mt-5 flex flex-wrap items-center justify-center gap-2.5 text-sm">
			<a
				href={codiceEticoPdfUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-sm btn-ghost border-secondary/30 bg-base-100/80 text-secondary hover:bg-secondary/10 gap-2 border"
			>
				<FileText class="size-4 shrink-0" />
				<span>{docs?.ethicsPdf?.heroLabel}</span>
				<ExternalLink class="size-3.5 shrink-0 opacity-70" />
			</a>
			<span class="text-base-content/30 hidden sm:inline">·</span>
			<a href="#criteri-selezione" class="link link-hover text-base-content/70 font-medium">
				{hero?.jumpCriteria}
			</a>
			<span class="text-base-content/30">·</span>
			<a href="#codice-etico" class="link link-hover text-base-content/70 font-medium">
				{hero?.jumpEthics}
			</a>
			<span class="text-base-content/30">·</span>
			<a href="#contatti-riservati" class="link link-hover text-base-content/70 font-medium">
				{hero?.jumpContacts}
			</a>
		</div>

		{
			locale !== 'it' && hero?.languageNoticeText && (
				<div class="border-info/30 bg-info/8 text-base-content/80 mx-auto mt-6 flex max-w-3xl items-start gap-3 rounded-xl border px-4 py-3 text-left text-xs leading-relaxed sm:text-sm">
					<Globe class="text-info mt-0.5 size-4 shrink-0 sm:size-5" />
					<p>
						<strong>{hero.languageNoticeTitle}</strong> {hero.languageNoticeText}
					</p>
				</div>
			)
		}

		<!-- Quick Key Numbers Strip -->
		<div
			class="bg-base-200/70 border-base-300/60 rounded-box mx-auto mt-10 grid max-w-4xl grid-cols-2 gap-px border shadow-sm backdrop-blur-sm sm:grid-cols-4"
		>
			{
				quickStats.map((stat) => (
					<div class="stat bg-base-100/70 px-4 py-5 text-center">
						<div class="stat-value from-primary to-secondary bg-linear-to-r bg-clip-text text-2xl text-transparent sm:text-3xl">
							{stat.statValue}
						</div>
						<div class="stat-title text-base-content/85 mt-1 text-xs font-bold sm:text-sm">
							{stat.label}
						</div>
						<div class="stat-desc text-base-content/60 mt-0.5 text-[11px] whitespace-normal">
							{stat.detail}
						</div>
					</div>
				))
			}
		</div>
	</HeroSection>

	<!-- =================================================================== -->
	<!-- SEZIONE 1: SINTESI VISIVA DEI CRITERI PUBBLICI DI SELEZIONE         -->
	<!-- =================================================================== -->
	<section id="criteri-selezione" class="bg-base-200/50 py-20 lg:py-24">
		<div class="container mx-auto px-4 lg:px-8">
			<div class="reveal mx-auto mb-14 max-w-3xl text-center">
				<SectionBadge icon={ClipboardCheck} label={selection?.badge} badgeClass="badge-primary" />
				<h2 class="mb-4 text-3xl font-bold sm:text-4xl md:text-5xl">
					{selection?.heading}<GradientSpan>{selection?.gradientWord}</GradientSpan>
				</h2>
				<p class="text-base-content/70 text-base leading-relaxed sm:text-lg">
					{selection?.intro}
				</p>
			</div>

			<div class="mx-auto max-w-6xl space-y-6">
				<!-- Row 1: Posti & Alloggio (Featured) + Ammessi di Diritto -->
				<div class="reveal-stagger grid gap-6 lg:grid-cols-12">
					<!-- Card: Partecipanti & Alloggio Combo Bologna -->
					<div
						class="card card-border border-primary/30 bg-base-100 card-interactive lg:col-span-7"
					>
						<div class="card-body p-6 sm:p-8">
							<div class="mb-4 flex flex-wrap items-center justify-between gap-2">
								<div class="flex items-center gap-3">
									<div
										class="from-primary/20 to-accent/20 flex size-12 shrink-0 items-center justify-center rounded-xl bg-linear-to-br"
									>
										<BedDouble class="text-primary size-6" />
									</div>
									<div>
										<h3 class="card-title text-xl sm:text-2xl">{accommodation?.title}</h3>
										<p class="text-base-content/60 text-xs sm:text-sm">{accommodation?.subtitle}</p>
									</div>
								</div>
								<span class="badge badge-primary badge-soft font-semibold">
									{accommodation?.badge}
								</span>
							</div>

							<div class="grid gap-4 sm:grid-cols-2">
								<div class="bg-base-200/60 border-primary/20 rounded-xl border p-4">
									<div class="text-primary mb-1 flex items-baseline gap-2">
										<span class="font-playfair-display text-3xl font-bold">
											{accommodation?.withStay?.count}
										</span>
										<span class="text-sm font-bold">{accommodation?.withStay?.title}</span>
									</div>
									<p class="text-base-content/75 text-sm leading-relaxed">
										{accommodation?.withStay?.description}
									</p>
								</div>

								<div class="bg-base-200/60 border-accent/25 rounded-xl border p-4">
									<div class="text-accent mb-1 flex items-baseline gap-2">
										<span class="font-playfair-display text-3xl font-bold">
											{accommodation?.withoutStay?.count}
										</span>
										<span class="text-sm font-bold">{accommodation?.withoutStay?.title}</span>
									</div>
									<p class="text-base-content/75 text-sm leading-relaxed">
										{accommodation?.withoutStay?.description}
									</p>
								</div>
							</div>

							<div
								class="border-secondary/25 bg-secondary/5 mt-4 flex items-start gap-3 rounded-xl border p-4 text-sm"
							>
								<Sparkles class="text-secondary mt-0.5 size-5 shrink-0" />
								<p class="text-base-content/80 leading-relaxed">
									<strong>{accommodation?.extraQuota?.title}</strong>{' '}
									{accommodation?.extraQuota?.beforeLink}<a
										href={aboutLink.href}
										class="link link-primary font-semibold">{accommodation?.extraQuota?.linkText}</a
									>{accommodation?.extraQuota?.afterLink}
								</p>
							</div>
						</div>
					</div>

					<!-- Card: Ammessi di Diritto -->
					<div
						class="card card-border border-secondary/30 bg-base-100 card-interactive lg:col-span-5"
					>
						<div class="card-body p-6 sm:p-8">
							<div class="mb-4 flex items-center gap-3">
								<div
									class="from-secondary/20 to-primary/20 flex size-12 shrink-0 items-center justify-center rounded-xl bg-linear-to-br"
								>
									<Award class="text-secondary size-6" />
								</div>
								<div>
									<h3 class="card-title text-xl sm:text-2xl">{automaticallyAdmitted?.title}</h3>
									<p class="text-base-content/60 text-xs sm:text-sm">
										{automaticallyAdmitted?.subtitle}
									</p>
								</div>
							</div>

							<ul class="space-y-3 text-sm">
								<li class="flex items-start gap-2.5">
									<CircleCheck class="text-secondary mt-0.5 size-4 shrink-0" />
									<span>
										<strong>{automaticallyAdmitted?.ocItem?.title}</strong>{
											automaticallyAdmitted?.ocItem?.beforeLink
										}<a href={aboutLink.href} class="link link-primary font-medium"
											>{automaticallyAdmitted?.ocItem?.linkText}</a
										>{automaticallyAdmitted?.ocItem?.afterLink}
									</span>
								</li>
								{
									(automaticallyAdmitted?.items ?? []).map((item) => (
										<li class="flex items-start gap-2.5">
											<CircleCheck class="text-secondary mt-0.5 size-4 shrink-0" />
											<span>{item}</span>
										</li>
									))
								}
								<li class="flex items-start gap-2.5">
									<CircleCheck class="text-secondary mt-0.5 size-4 shrink-0" />
									<span>
										<strong>{automaticallyAdmitted?.winnerItem?.title}</strong>{
											automaticallyAdmitted?.winnerItem?.text
										}
									</span>
								</li>
							</ul>
						</div>
					</div>
				</div>

				<!-- Row 2: Quote Minime LC, Proporzionalità, Parità di Genere -->
				<div class="reveal-stagger grid gap-6 md:grid-cols-3">
					<!-- Quote minime per LC & Calabria -->
					<div class="card card-border border-primary/30 bg-base-100 card-interactive">
						<div class="card-body p-6">
							<div
								class="from-primary/20 to-secondary/20 mb-4 flex size-12 items-center justify-center rounded-xl bg-linear-to-br"
							>
								<MapPin class="text-primary size-6" />
							</div>
							<h3 class="card-title mb-2 text-lg">{minQuotas?.title}</h3>
							<p class="text-base-content/75 mb-3 text-sm leading-relaxed">
								{minQuotas?.description}
							</p>
							<div class="bg-warning/10 border-warning/30 mt-auto rounded-lg border p-3 text-xs">
								<strong class="text-warning-content">{minQuotas?.supportTitle}</strong>{' '}
								{minQuotas?.supportText}
							</div>
						</div>
					</div>

					<!-- Proporzionalità candidature -->
					<div class="card card-border border-accent/35 bg-base-100 card-interactive">
						<div class="card-body p-6">
							<div
								class="from-accent/20 to-warning/20 mb-4 flex size-12 items-center justify-center rounded-xl bg-linear-to-br"
							>
								<TrendingUp class="text-accent size-6" />
							</div>
							<h3 class="card-title mb-2 text-lg">{proportionality?.title}</h3>
							<p class="text-base-content/75 mb-3 text-sm leading-relaxed">
								{proportionality?.description}
							</p>
							<div class="bg-accent/10 border-accent/25 mt-auto rounded-lg border p-3 text-xs">
								<strong>{proportionality?.tipTitle}</strong>{' '}
								{proportionality?.tipText}
							</div>
						</div>
					</div>

					<!-- Parità di genere -->
					<div class="card card-border border-secondary/30 bg-base-100 card-interactive">
						<div class="card-body p-6">
							<div
								class="from-secondary/20 to-primary/20 mb-4 flex size-12 items-center justify-center rounded-xl bg-linear-to-br"
							>
								<Users class="text-secondary size-6" />
							</div>
							<h3 class="card-title mb-2 text-lg">{parity?.title}</h3>
							<p class="text-base-content/75 mb-3 text-sm leading-relaxed">
								{parity?.description}
							</p>
							<div class="bg-info/10 border-info/25 mt-auto rounded-lg border p-3 text-xs">
								<strong>{parity?.languageTitle}</strong>{' '}
								{parity?.languageText}
							</div>
						</div>
					</div>
				</div>

				<!-- Row 3: Fasce Accademiche & Fattori di Valutazione -->
				<div class="reveal-stagger grid gap-6 lg:grid-cols-2">
					<!-- Fasce accademiche ed esterni -->
					<div class="card card-border border-info/30 bg-base-100 card-interactive">
						<div class="card-body p-6 sm:p-7">
							<div class="mb-3 flex items-center gap-3">
								<div
									class="from-info/20 to-primary/20 flex size-11 shrink-0 items-center justify-center rounded-xl bg-linear-to-br"
								>
									<GraduationCap class="text-info size-6" />
								</div>
								<div>
									<h3 class="card-title text-xl">{academic?.title}</h3>
									<p class="text-base-content/60 text-xs">{academic?.subtitle}</p>
								</div>
							</div>

							<div class="mb-3 flex flex-wrap gap-2">
								{
									(academic?.levels ?? []).map((level, idx) => {
										const isExcluded =
											baseCriteria.selectionSection?.academicCard?.levels?.[idx]?.excluded ??
											level.excluded;
										return (
											<span
												class:list={[
													'badge',
													isExcluded
														? 'badge-ghost text-xs'
														: 'badge-info badge-soft font-semibold',
												]}
											>
												{level.label}
											</span>
										);
									})
								}
							</div>

							<p class="text-base-content/75 mb-3 text-sm leading-relaxed">
								{academic?.distributionText}
							</p>
							<p class="text-base-content/70 text-sm leading-relaxed">
								<strong><u>{academic?.externalTitle}</u></strong>{' '}
								{academic?.externalText}
							</p>
						</div>
					</div>

					<!-- Fattori considerati in candidatura e motivazione -->
					<div class="card card-border border-primary/30 bg-base-100 card-interactive">
						<div class="card-body p-6 sm:p-7">
							<div class="mb-3 flex items-center gap-3">
								<div
									class="from-primary/20 to-warning/20 flex size-11 shrink-0 items-center justify-center rounded-xl bg-linear-to-br"
								>
									<Sparkles class="text-primary size-6" />
								</div>
								<div>
									<h3 class="card-title text-xl">{factors?.title}</h3>
									<p class="text-base-content/60 text-xs">{factors?.subtitle}</p>
								</div>
							</div>

							<ul class="space-y-2.5 text-sm">
								{
									(factors?.factors ?? []).map((factor) => (
										<li class="text-base-content/80 flex items-start gap-2.5 leading-relaxed">
											<ArrowRight class="text-primary mt-1 size-4 shrink-0" />
											<span>{factor}</span>
										</li>
									))
								}
							</ul>
						</div>
					</div>
				</div>

				<!-- Row 4: Cause di Rigetto Irrevocabile (Alert Card) -->
				<div class="reveal card card-border border-error/40 bg-error/5 shadow-sm">
					<div class="card-body p-6 sm:p-8">
						<div class="mb-5 flex flex-wrap items-center gap-3">
							<div
								class="bg-error/15 text-error flex size-12 shrink-0 items-center justify-center rounded-xl"
							>
								<TriangleAlert class="size-6" />
							</div>
							<div>
								<h3 class="card-title text-error text-xl sm:text-2xl">{rejection?.title}</h3>
								<p class="text-base-content/70 text-sm">{rejection?.subtitle}</p>
							</div>
						</div>

						<div class="grid gap-4 sm:grid-cols-2">
							{
								(rejection?.causes ?? []).map((cause) => (
									<div class="border-error/25 bg-base-100/90 rounded-xl border p-4">
										<p class="text-error mb-1 text-sm font-bold">{cause.title}</p>
										<p class="text-base-content/75 text-xs leading-relaxed sm:text-sm">
											{cause.desc}
										</p>
									</div>
								))
							}
						</div>
					</div>
				</div>

				<!-- Row 5: Pagamenti entro 7 giorni, Ripescaggio, Politica Rimborsi & Avvertenze -->
				<div class="reveal-stagger grid gap-6 lg:grid-cols-2">
					<!-- Pagamenti & Politica Rimborsi -->
					<div class="card card-border border-warning/40 bg-base-100 card-interactive">
						<div class="card-body p-6 sm:p-7">
							<div class="mb-4 flex items-center gap-3">
								<div
									class="from-warning/25 to-primary/20 flex size-11 shrink-0 items-center justify-center rounded-xl bg-linear-to-br"
								>
									<Clock class="text-warning size-6" />
								</div>
								<div>
									<h3 class="card-title text-xl">{payments?.title}</h3>
									<p class="text-base-content/60 text-xs">{payments?.subtitle}</p>
								</div>
							</div>

							<ul class="space-y-3 text-sm leading-relaxed">
								{
									(payments?.items ?? []).map((item, idx) => {
										const isAlert =
											baseCriteria.selectionSection?.paymentsCard?.items?.[idx]?.isAlert ??
											item.isAlert;
										return (
											<li class="flex items-start gap-2.5">
												{isAlert ? (
													<TriangleAlert class="text-error mt-0.5 size-4 shrink-0" />
												) : (
													<CircleCheck class="text-warning mt-0.5 size-4 shrink-0" />
												)}
												<span>
													<strong>{item.title}</strong> {item.text}
												</span>
											</li>
										);
									})
								}
							</ul>
						</div>
					</div>

					<!-- Avvertenze, Garanzie EC & Accessibilità -->
					<div class="card card-border border-success/35 bg-base-100 card-interactive">
						<div class="card-body p-6 sm:p-7">
							<div class="mb-4 flex items-center gap-3">
								<div
									class="from-success/20 to-info/20 flex size-11 shrink-0 items-center justify-center rounded-xl bg-linear-to-br"
								>
									<Info class="text-success size-6" />
								</div>
								<div>
									<h3 class="card-title text-xl">{guarantees?.title}</h3>
									<p class="text-base-content/60 text-xs">{guarantees?.subtitle}</p>
								</div>
							</div>

							<div class="space-y-3 text-sm leading-relaxed">
								<div class="bg-success/8 border-success/25 rounded-xl border p-3.5">
									<p class="text-success mb-1 font-bold">{guarantees?.accessibilityTitle}</p>
									<p class="text-base-content/80 text-xs leading-relaxed sm:text-sm">
										{guarantees?.accessibilityText}
									</p>
								</div>

								<p class="text-base-content/75">
									<strong>{guarantees?.ecOversightTitle}</strong>{' '}
									{guarantees?.ecOversightBeforeEmail}<a
										href={`mailto:${mainEmail}`}
										class="link link-primary font-medium">{mainEmail}</a
									>{guarantees?.ecOversightAfterEmail}
								</p>

								<p class="text-base-content/70 text-xs sm:text-sm">
									<strong>{guarantees?.safeguardTitle}</strong>{' '}
									{guarantees?.safeguardText}
								</p>
							</div>

							<div class="mt-5 pt-2">
								<a
									href={criteriPdfUrl}
									target="_blank"
									rel="noopener noreferrer"
									class="btn btn-primary btn-outline btn-sm sm:btn-md w-full gap-2 sm:w-auto"
								>
									<Download class="size-4 shrink-0" />
									<span>{docs?.criteriaPdf?.shortLabel}</span>
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- =================================================================== -->
	<!-- SEZIONE 2: IL CODICE ETICO DI CISF27 BOLOGNA                        -->
	<!-- =================================================================== -->
	<section id="codice-etico" class="bg-base-100 py-20 lg:py-24">
		<div class="container mx-auto px-4 lg:px-8">
			<div class="reveal mx-auto mb-12 max-w-3xl text-center">
				<SectionBadge icon={ShieldCheck} label={ethics?.badge} badgeClass="badge-secondary" />
				<h2 class="mb-4 text-3xl font-bold sm:text-4xl md:text-5xl">
					{ethics?.heading}<GradientSpan gradient="from-secondary to-primary"
						>{ethics?.gradientWord}</GradientSpan
					>
				</h2>
				<p class="text-base-content/70 mb-7 text-base leading-relaxed sm:text-lg">
					{ethics?.intro}
				</p>
				<div class="flex flex-wrap items-center justify-center gap-3">
					<a
						href={codiceEticoPdfUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-secondary btn-md sm:btn-lg shadow-secondary/20 hover:shadow-secondary/35 card-interactive gap-2 shadow-lg"
					>
						<Download class="size-5 shrink-0" />
						<span>{docs?.ethicsPdf?.sectionLabel}</span>
					</a>
					<a href="#contatti-riservati" class="btn btn-ghost btn-md sm:btn-lg gap-2">
						<Lock class="text-secondary size-4 shrink-0" />
						<span>{ethics?.confidentialBtn}</span>
					</a>
				</div>
			</div>

			<!-- Ethical Pillars Grid -->
			<div class="reveal-stagger mx-auto grid max-w-6xl gap-6 md:grid-cols-2 lg:grid-cols-3">
				{
					(ethics?.pillars ?? []).map((pillar, index) => {
						const basePillar = baseCriteria.ethicsSection?.pillars?.[index];
						const Icon = resolveIcon(basePillar?.icon ?? pillar.icon);
						const colorKey = basePillar?.color ?? pillar.color ?? 'primary';
						const styles = pillarStyleMap[colorKey] ?? pillarStyleMap.primary;
						const showPlasticFree = basePillar?.hasPlasticFreeLogo ?? pillar.hasPlasticFreeLogo;

						return (
							<article
								class:list={[
									'card card-border bg-base-200/40 card-interactive flex flex-col',
									styles.borderColor,
								]}
							>
								<div class="card-body flex flex-1 flex-col p-6">
									<div class="mb-4 flex items-start justify-between gap-3">
										<div
											class:list={[
												'flex size-12 shrink-0 items-center justify-center rounded-xl bg-linear-to-br',
												styles.accentBg,
											]}
										>
											{Icon && <Icon class:list={['size-6', styles.iconColor]} />}
										</div>
										<span class:list={['badge badge-sm font-semibold', styles.badgeClass]}>
											{pillar.badge}
										</span>
									</div>

									<h3 class="card-title mb-2 text-xl leading-snug">{pillar.title}</h3>
									<p class="text-base-content/75 mb-4 text-sm leading-relaxed">
										{pillar.description}
									</p>

									{showPlasticFree && (
										<div class="bg-base-100 border-success/25 mb-4 flex items-center gap-3 rounded-xl border p-3">
											<Image
												src={plasticFreerLogo}
												alt={ethics?.plasticFreeLogoAlt ?? '#Plastic-freER'}
												class="h-11 w-auto shrink-0 object-contain"
											/>
											<p class="text-base-content/70 text-xs leading-snug">
												{ethics?.plasticFreeCaption}
											</p>
										</div>
									)}

									<ul class="border-base-300/70 mt-auto space-y-2 border-t pt-4 text-xs sm:text-sm">
										{(pillar.points ?? []).map((point) => (
											<li class="text-base-content/80 flex items-start gap-2">
												<CircleCheck class:list={['mt-0.5 size-4 shrink-0', styles.iconColor]} />
												<span>{point}</span>
											</li>
										))}
									</ul>
								</div>
							</article>
						);
					})
				}
			</div>

			<!-- Box Contatti Riservati dei Coordinatori Generali -->
			<div id="contatti-riservati" class="reveal mx-auto mt-14 max-w-5xl">
				<div
					class="card card-border border-secondary/35 from-secondary/10 via-base-100 to-primary/10 bg-linear-to-br shadow-md"
				>
					<div class="card-body p-6 sm:p-8 lg:p-10">
						<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
							<div class="flex items-start gap-4">
								<div
									class="from-secondary to-primary text-primary-content flex size-14 shrink-0 items-center justify-center rounded-2xl bg-linear-to-br shadow-md"
								>
									<Lock class="size-7" />
								</div>
								<div>
									<span class="badge badge-secondary badge-soft badge-sm mb-2 font-semibold">
										{confidentialBox?.badge}
									</span>
									<h3 class="text-2xl font-bold sm:text-3xl">{confidentialBox?.heading}</h3>
									<p
										class="text-base-content/75 mt-1 max-w-2xl text-sm leading-relaxed sm:text-base"
									>
										{confidentialBox?.description}
									</p>
								</div>
							</div>
						</div>

						<div class="grid gap-4 md:grid-cols-2">
							{
								confidentialContacts.map((coord) => (
									<div class="card card-border border-primary/25 bg-base-100/90 p-5 shadow-xs transition hover:shadow-md">
										<div class="flex items-center gap-4">
											<div class="from-primary/20 to-secondary/20 text-primary flex size-12 shrink-0 items-center justify-center rounded-full bg-linear-to-br font-bold">
												{getInitials(coord.name)}
											</div>
											<div class="min-w-0 flex-1">
												<p class="text-base font-bold sm:text-lg">{coord.name}</p>
												<p class="text-secondary text-xs font-medium sm:text-sm">
													{coord.roleDescription ?? coord.role}
												</p>
												{coord.email && (
													<a
														href={`mailto:${coord.email}`}
														class="link link-primary mt-1.5 inline-flex items-center gap-1.5 text-sm font-semibold break-all"
													>
														<Mail class="size-4 shrink-0" />
														<span>{coord.email}</span>
													</a>
												)}
											</div>
										</div>
									</div>
								))
							}
						</div>

						<div
							class="border-base-300/70 text-base-content/70 mt-6 flex flex-col gap-3 border-t pt-5 text-xs leading-relaxed sm:flex-row sm:items-center sm:justify-between sm:text-sm"
						>
							<p>
								<strong>{confidentialBox?.guaranteeTitle}</strong>{' '}
								{confidentialBox?.guaranteeText}
							</p>
							<a
								href={`mailto:${mainEmail}`}
								class="btn btn-sm btn-outline btn-primary shrink-0 gap-1.5"
							>
								<Mail class="size-3.5" />
								<span>{mainEmail}</span>
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- =================================================================== -->
	<!-- CTA FINALE                                                          -->
	<!-- =================================================================== -->
	<CTASection bgClass="from-primary/10 via-base-100 to-secondary/10">
		<Fragment slot="icon">
			<GraduationCap class="text-primary mx-auto mb-6 size-16" />
		</Fragment>
		<Fragment slot="heading">
			<h2 class="mb-5 text-3xl font-bold sm:text-4xl md:text-5xl">
				{cta?.heading}<GradientSpan class="char-stagger">{cta?.gradientWord}</GradientSpan>{
					cta?.headingSuffix
				}
			</h2>
		</Fragment>
		<Fragment slot="subtitle">
			<p class="text-base-content/70 mb-8 text-base leading-relaxed sm:text-lg">
				{cta?.subtitle}
				{
					locale !== 'it' && cta?.languageNote && (
						<span class="text-base-content/55 mt-2 block text-sm">{cta.languageNote}</span>
					)
				}
			</p>
		</Fragment>
		<Fragment slot="actions">
			<a
				href={iscrizioneUrl}
				class="btn btn-primary btn-lg shadow-primary/25 hover:shadow-primary/40 card-interactive glow-hover gap-2 shadow-xl"
			>
				<NotebookPen class="size-5 shrink-0" />
				<span>{cta?.applyBtn}</span>
				<ArrowRight class="size-4 shrink-0" />
			</a>
			<a
				href={criteriPdfUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-outline btn-primary btn-lg card-interactive gap-2"
			>
				<Download class="size-5 shrink-0" />
				<span>{docs?.criteriaPdf?.ctaLabel}</span>
			</a>
			<a
				href={codiceEticoPdfUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-outline btn-secondary btn-lg card-interactive gap-2"
			>
				<FileText class="size-5 shrink-0" />
				<span>{docs?.ethicsPdf?.ctaLabel}</span>
			</a>
			<a href={contactLink.href} class="btn btn-ghost btn-lg gap-1.5">
				<span>{cta?.contactBtn}</span>
			</a>
		</Fragment>
	</CTASection>
</PageLayout>
