---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import BaseLayout from './BaseLayout.astro';
import type PageProps from '../types/pageProps';
import { ChevronUp } from '@lucide/astro';
import { getCmsData, getLocale } from '../data/cms';

const props = Astro.props as PageProps;
const locale = getLocale(Astro);
const { footer } = getCmsData(locale);
---

<BaseLayout {...props}>
	<Navbar />
	<slot />
	<Footer />
	<a
		href="#"
		class="back-to-top from-primary to-secondary text-primary-content pointer-events-none fixed right-4 bottom-20 z-40 flex size-10 translate-y-5 items-center justify-center rounded-full bg-linear-to-br text-lg opacity-0 shadow-lg transition-all duration-300 hover:scale-110 sm:right-8 sm:bottom-8 sm:size-12 sm:text-xl"
		aria-label={footer.backToTop || 'Torna su'}
	>
		<ChevronUp class="size-5" />
	</a>
</BaseLayout>
