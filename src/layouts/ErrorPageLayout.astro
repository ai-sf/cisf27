---
import BaseLayout from '../layouts/BaseLayout.astro';
import type PageProps from '../types/pageProps';
import { House } from '@lucide/astro';
import { homeLink } from '../data/pageLinks.ts';
import { errorContent } from '../data/cms';

const props = Astro.props as PageProps & { code?: number; message?: string };

const code = props.code || 0;
const message = props.message || errorContent.defaultMessage;
---

<BaseLayout {...props} title={`${errorContent.errorPageTitlePrefix}${code}`}>
	<div class="hero from-base-100 via-base-200 to-base-300 min-h-screen bg-linear-to-br">
		<div class="hero-content flex-col gap-1 font-bold">
			<p class="text-error text-4xl uppercase">{errorContent.label}</p>
			<h1
				class="from-primary via-secondary to-base-content bg-linear-to-r bg-clip-text text-8xl text-transparent"
			>
				{code}
			</h1>
			<p class="text-2xl">{message}</p>
			<a tabindex="0" href={homeLink.href} class="btn btn-primary m-4 uppercase">
				<House class="size-6" />
				<span>{errorContent.button}</span>
			</a>
		</div>
	</div>
</BaseLayout>
