---
import { Icon as LucideIcon } from '@lucide/astro';
import SectionBadge from './SectionBadge.astro';
import GradientSpan from './GradientSpan.astro';
import type { Stat } from '../data/stats.ts';

export interface Props {
	badgeIcon?: typeof LucideIcon;
	badgeLabel?: string;
	heading?: string;
	gradientWord?: string;
	gradient?: string;
	paragraphs?: (string | undefined)[];
	stats: Stat[];
	id?: string;
}

const {
	badgeIcon,
	badgeLabel,
	heading,
	gradientWord,
	gradient = 'from-primary to-secondary',
	paragraphs,
	stats,
	id,
} = Astro.props;
---

<section {id} class="reveal bg-base-200/50 py-24">
	<div class="container mx-auto px-4 lg:px-8">
		<div class="grid items-center gap-16 lg:grid-cols-2">
			<div>
				<SectionBadge icon={badgeIcon} label={badgeLabel} />
				<h2 class="mb-6 text-4xl leading-tight font-bold">
					{heading}<br />
					<GradientSpan {gradient} class="char-stagger">{gradientWord}</GradientSpan>
				</h2>
				{
					(paragraphs ?? []).map((para, i) => (
						<p
							class:list={[
								i === 0
									? 'text-base-content/70 mb-6 text-lg leading-relaxed'
									: 'text-base-content/60 leading-relaxed',
							]}
						>
							{para}
						</p>
					))
				}
			</div>

			<div class="relative">
				<div
					class="from-primary/10 to-secondary/10 border-base-300/50 rounded-3xl border bg-linear-to-br p-8"
				>
					<div class="reveal-stagger grid grid-cols-2 gap-4">
						{
							stats.map((stat) => (
								<div class="card card-border border-primary/30 bg-base-100/60 card-interactive p-6 text-center">
									{stat.icon && <stat.icon class="text-primary/60 mx-auto mb-2 size-6" />}
									<div class="stat-value from-primary to-secondary bg-linear-to-r bg-clip-text text-3xl font-bold text-transparent">
										{stat.number}
									</div>
									<div class="text-base-content/60 mt-1 text-sm">{stat.label}</div>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
