---
import { Icon as LucideIcon } from '@lucide/astro';

export interface Props {
	icon?: typeof LucideIcon;
	label?: string;
	badgeClass?: string;
	heading?: string;
	headingClass?: string;
	bgClass?: string;
	subtitle?: string;
	id?: string;
}

const {
	icon: Icon,
	label,
	badgeClass = 'badge-primary badge-soft',
	heading,
	headingClass = 'from-primary to-secondary',
	bgClass = '',
	subtitle,
	id,
} = Astro.props;
---

<section
	{id}
	class:list={[
		'hero bg-base-100 relative overflow-hidden py-20 sm:py-24 md:py-32',
		bgClass,
		'bg-linear-to-br via-transparent',
	]}
>
	<div class="hero-content relative z-10 px-4 text-center sm:px-6">
		<div class="max-w-full">
			{
				Icon && (
					<div
						class:list={[
							'badge',
							badgeClass,
							'badge-soft mb-8 h-fit max-h-fit gap-2 py-1 pe-4 text-sm',
						]}
					>
						<Icon class="size-4 shrink-0" />
						{label}
					</div>
				)
			}
			<h1
				class="mb-6 text-3xl font-bold tracking-tight text-balance sm:text-5xl md:text-6xl lg:text-7xl"
			>
				<span
					class:list={[
						headingClass,
						'inline-block max-w-full bg-linear-to-r bg-clip-text break-words text-transparent',
					]}
				>
					{heading}
				</span>
			</h1>
			<p class="text-base-content/60 mx-auto max-w-2xl text-base sm:text-lg">
				{subtitle}
			</p>
		</div>
	</div>
</section>
