---
import { Icon as LucideIcon } from '@lucide/astro';

export interface Props {
	icon?: typeof LucideIcon;
	label?: string;
	badgeClass?: string;
	id?: string;
}

const { icon: Icon, label, badgeClass = 'badge-primary badge-soft', id } = Astro.props;
---

{
	Icon && (
		<div {id} class:list={['badge', badgeClass, 'mb-6 gap-2 py-3 pe-5 text-sm']}>
			<Icon class="size-4" />
			<span>{label}</span>
		</div>
	)
}
